<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <ProjectReference Include="$(QualificationAuthSourceRoot)/Legacy.Maliev.AuthService.Infrastructure/Legacy.Maliev.AuthService.Infrastructure.csproj" />
  </ItemGroup>
  <Target Name="RequireIsolatedSource" BeforeTargets="PrepareForBuild" Condition="'$(QualificationAuthSourceRoot)' == ''">
    <Error Text="QualificationAuthSourceRoot must identify the privately pinned Auth checkout." />
  </Target>
</Project>
